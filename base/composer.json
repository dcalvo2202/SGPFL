{
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "php-mock/php-mock-phpunit": "^2.7",
        "codeception/codeception": "5.3.*",
        "codeception/module-phpbrowser": "4.*",
        "codeception/module-asserts": "3.3.*"
    },
    "scripts": {
        "test": "phpunit -c phpunit.unit.xml --colors=always --testdox",
        "test:unit": "phpunit -c phpunit.unit.xml --colors=always --testdox",
        "test:integration": "phpunit -c phpunit.integration.xml --colors=always --testdox",
        "test:functional": "codecept run functional --steps",
        "test:functional:debug": "codecept run functional -vvv --debug"
    },
    "require": {
        "php-webdriver/webdriver": "^1.1",
        "phpmailer/phpmailer": "^7.0",
        "google/apiclient": "^2.19"
    },
    "autoload": {
        "psr-4": {
            "Service\\": "service/"
        }
    }
}
